# ============================================================================
# AegisOps environment configuration  (ZERO-CARD / FREE TIER)
# Copy this file to `.env` and fill in your values. NEVER commit `.env`.
# ============================================================================

# --- REQUIRED: Google AI Studio API key (free tier, no billing account) ---
# Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=paste_your_ai_studio_key_here

# --- Model id. Spec default is gemini-3.5-flash. If your key 403/404s on that
#     exact id, change ONLY this line (e.g. gemini-2.0-flash). Flash only. ---
GEMINI_MODEL=gemini-3.5-flash

# --- OPTIONAL: Slack incoming webhook for the Comms agent. If unset, the
#     Comms agent prints the payload to console/UI instead (clean fallback). ---
SLACK_WEBHOOK_URL=

# --- Server ---
HOST=0.0.0.0
PORT=8080

# --- Storage. SQLite path (local, zero-billing). The StorageService interface
#     swaps to Firestore by changing one impl class. ---
AEGIS_DB_PATH=aegisops.db

# --- Retry/backoff tuning for the 503-safe Gemini wrapper ---
GEMINI_MAX_RETRIES=5
GEMINI_BASE_DELAY=1.0
